# Copiez ce fichier en ".env" (qui n'est JAMAIS versionné) puis changez les mots de passe.
#   Windows (PowerShell) : Copy-Item .env.example .env
#   Linux / macOS        : cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=taskflow
POSTGRES_USER=siwar
POSTGRES_PASSWORD=changez-moi-postgres

# --- Compte administrateur de la console Keycloak (http://localhost:8180) ---
KEYCLOAK_ADMIN=siwar
KEYCLOAK_ADMIN_PASSWORD=changez-moi-keycloak

# --- Adresses PUBLIQUES (celles que le navigateur utilise) ---
KEYCLOAK_PUBLIC_URL=http://localhost:8180
API_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173
